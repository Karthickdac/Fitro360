{
  "name": "fitro360-relay-agent",
  "version": "1.2.1",
  "description": "Fitro360 on-prem relay agent. Polls the Fitro360 cloud for queued device commands and executes them on biometric devices on the local gym LAN.",
  "main": "src/index.js",
  "type": "commonjs",
  "bin": {
    "fitro360-relay": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "setup": "node src/index.js --setup",
    "test": "node tests/signing.test.js && node tests/poller.test.js && node tests/setup.test.js",
    "package:win": "npx --yes @yao-pkg/pkg . --targets node20-win-x64 --compress GZip --output dist/fitro360-relay.exe",
    "package:linux": "npx --yes @yao-pkg/pkg . --targets node20-linux-x64 --compress GZip --output dist/fitro360-relay-linux",
    "package:macos": "npx --yes @yao-pkg/pkg . --targets node20-macos-x64 --compress GZip --output dist/fitro360-relay-macos",
    "release:win": "bash scripts/build-windows.sh"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "config.example.json",
      "package.json"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
